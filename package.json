{
  "name": "@bkreact/ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev --port 6006 --host 127.0.0.1 --no-open --ci",
    "storybook": "npm run dev",
    "build:docs": "storybook build --output-dir .storybook-static",
    "test": "node --test scripts/*.test.mjs src/components/*/*.test.mjs",
    "tokens:build": "node scripts/generate-theme-tokens.mjs",
    "tokens:check": "node scripts/generate-theme-tokens.mjs --check",
    "tokens:test": "node --test scripts/generate-theme-tokens.test.mjs",
    "button:test": "node --test src/components/button/button.test.mjs",
    "typecheck": "tsc --noEmit",
    "icons:build": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "icon:test": "node --test src/components/icon/icon.test.mjs",
    "loading:test": "node --test src/components/loading/loading.test.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind-entry.css",
    "./tailwind-preset": "./dist/tailwind-preset.js",
    "./safelist.css": "./dist/safelist.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.31",
    "react-dom": "19.3.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@types/react": "19.3.0",
    "clsx": "^2.1.1",
    "decimal.js-light": "^2.5.1",
    "react": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
