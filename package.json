{
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "storybook dev --config-dir apps/storybook-web/.storybook --port 6006 --host 127.0.0.1 --no-open --ci",
    "storybook": "npm run dev",
    "build:docs": "storybook build --config-dir apps/storybook-web/.storybook --output-dir .storybook-static/web",
    "test": "node --test scripts/*.test.mjs packages/ui-react/src/components/*/*.test.mjs",
    "tokens:build": "node scripts/generate-theme-tokens.mjs",
    "tokens:check": "node scripts/generate-theme-tokens.mjs --check",
    "tokens:test": "node --test scripts/generate-theme-tokens.test.mjs scripts/native-tokens.test.mjs scripts/nativewind.test.mjs",
    "button:test": "node --test packages/ui-react/src/components/button/button.test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/ui-native/tsconfig.json",
    "icons:build": "node scripts/generate-icons.mjs && npm run build --workspace=@bkreact/assets",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "icon:test": "node --test packages/ui-react/src/components/icon/icon.test.mjs",
    "loading:test": "node --test packages/ui-react/src/components/loading/loading.test.mjs",
    "build": "npm run tokens:build && npm run build --workspace=@bkreact/assets && npm run build --workspace=@bkreact/ui && npm run build --workspace=@bkreact/ui-native",
    "dev:native": "storybook dev --config-dir apps/storybook-native-web/.storybook --port 6007 --host 127.0.0.1 --no-open --ci",
    "build:docs:native": "storybook build --config-dir apps/storybook-native-web/.storybook --output-dir .storybook-static/native",
    "pretest": "npm run build --workspace=@bkreact/assets",
    "pretypecheck": "npm run build --workspace=@bkreact/assets",
    "predev": "npm run build --workspace=@bkreact/assets",
    "predev:native": "npm run build --workspace=@bkreact/assets",
    "prebuild:docs": "npm run build --workspace=@bkreact/assets",
    "prebuild:docs:native": "npm run build --workspace=@bkreact/assets"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@base-ui/react": "1.9.0",
    "@expo/metro-config": "57.0.12",
    "@react-native/metro-config": "0.86.3",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-native-web-vite": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "4.1.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "decimal.js-light": "^2.5.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-rc.0",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "storybook": "^10.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.1.12",
    "tsup": "^9.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "name": "bkui-factory",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "resolutions": {
    "@expo/metro-config/lightningcss": "1.30.1"
  }
}
