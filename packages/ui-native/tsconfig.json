{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../scripts/native-button.typecheck.tsx",
    "../../apps/storybook-native-web/.storybook/preview.tsx"
  ]
}
