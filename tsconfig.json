{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true
  },
  "include": [
    "packages/ui-react/src/**/*.ts",
    "packages/ui-react/src/**/*.tsx",
    "scripts/button.typecheck.tsx",
    "apps/storybook-web/.storybook/preview.tsx",
    "docs/**/*.stories.tsx"
  ]
}
