{
  "base": {
    "color": {
      "$type": "color",
      "$value": "{semantic.color-text-primary}"
    },
    "muted-color": {
      "$type": "color",
      "$value": "{semantic.color-text-secondary}"
    },
    "line-color": {
      "$type": "color",
      "$value": "{semantic.color-border-default}"
    },
    "marker-color": {
      "$type": "color",
      "$value": "{semantic.color-text-tertiary}"
    },
    "marker-bg": {
      "$type": "color",
      "$value": "{semantic.color-text-tertiary}"
    },
    "line-width": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "marker-border-width": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "content-gap": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "title-font-weight": {
      "$type": "number",
      "$value": 500
    },
    "time-color": {
      "$type": "color",
      "$value": "{semantic.color-text-tertiary}"
    },
    "step-active-color": {
      "$type": "color",
      "$value": "{semantic.color-text-primary}"
    },
    "step-pending-color": {
      "$type": "color",
      "$value": "{semantic.color-fill-subtle}"
    },
    "step-text-color": {
      "$type": "color",
      "$value": "{semantic.color-surface-container}",
      "$description": "活动/完成步骤背景使用 text-primary（浅色主题为深色、深色主题为浅色），需要与之相反的前景。现有 text-inverse 和 action-primary-content 在两种主题中均为白色，不适用于此背景，因此暂借 surface-container 提供随主题反转的前景色；通过 --timeline-step-text-color 可独立覆盖。"
    },
    "step-pending-text-color": {
      "$type": "color",
      "$value": "{semantic.color-text-primary}",
      "$description": "pending 状态专用的可覆盖文字色别名。pending Item 会用它覆盖继承的 --timeline-step-text-color；若需统一所有状态，调用方应同时覆盖这两个 tokens。"
    }
  },
