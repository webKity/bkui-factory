{
  "Scale": {
    "none": {
      "$type": "number",
      "$value": 0,
      "$description": "无圆角：分割线、表格区域和直角布局。",
      "$extensions": {
        "com.figma.variableId": "VariableID:154:3",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ]
      }
    },
    "xs": {
      "$type": "number",
      "$value": 4,
      "$description": "极小圆角：紧凑控件、微型按钮和局部状态块。",
      "$extensions": {
        "com.figma.variableId": "VariableID:154:4",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ]
      }
    },
    "sm": {
      "$type": "number",
      "$value": 8,
      "$description": "小圆角：标签、轻量控件和小尺寸操作元素。",
      "$extensions": {
        "com.figma.variableId": "VariableID:154:5",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ]
      }
    },
    "md": {
      "$type": "number",
      "$value": 12,
      "$description": "标准圆角：Button、Input、Select 等常规控件。",
      "$extensions": {
        "com.figma.variableId": "VariableID:154:6",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ]
      }
    },
    "lg": {
      "$type": "number",
      "$value": 16,
      "$description": "大圆角：资产卡片、独立内容容器和内容面板。",
      "$extensions": {
        "com.figma.variableId": "VariableID:154:7",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ]
      }
    },
    "xl": {
      "$type": "number",
      "$value": 20,
      "$description": "超大圆角：大型 Card、Modal 和弹层。",
      "$extensions": {
        "com.figma.variableId": "VariableID:154:8",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ]
      }
    },
    "2xl": {
      "$type": "number",
      "$value": 24,
      "$description": "特大圆角：品牌展示和强调型大型容器。",
      "$extensions": {
        "com.figma.variableId": "VariableID:154:9",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ]
      }
    },
    "full": {
      "$type": "number",
      "$value": 9999,
      "$description": "完全圆角：胶囊控件、圆形头像和圆形图标底。",
      "$extensions": {
        "com.figma.variableId": "VariableID:159:2",
        "com.figma.scopes": [
          "CORNER_RADIUS"
        ]
      }
    }
  },
  "$extensions": {
    "com.figma.modeName": "Default / 默认"
  }
}